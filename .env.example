VITE_API_BASE_URL=http://localhost:5000/api

# PostgreSQL (for example, a Supabase or Neon connection string).
# Keep this secret in your local .env and your backend host's environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only if your PostgreSQL provider requires SSL.
DATABASE_SSL=false

# Gmail SMTP (use a Google App Password, not your normal account password).
# Keep these values in your local .env file; never commit real credentials.
